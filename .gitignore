/logs/raw-read-workflow/**/multiqc_*.log
/results/validation/raw-read-workflow/runs/*/fasterq_size_check.txt

# Empty success-path logs; substantive execution logs and validation tables remain public
/logs/raw-read-workflow/CK-1/validate_manual_checkpoint.log
