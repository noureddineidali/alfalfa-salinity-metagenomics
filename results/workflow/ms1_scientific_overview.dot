digraph raw_read_overview {
  graph [
    rankdir=TB, bgcolor="white", pad="0.22", nodesep="0.35", ranksep="0.34",
    splines=ortho, outputorder=edgesfirst, fontname="DejaVu Sans",
    label="MS-1 | independent raw-read reconstruction", labelloc=t,
    fontsize=18, fontcolor="#20354B"
  ];
  node [
    shape=box, style="rounded,filled", penwidth=1.5, width=3.7,
    fontname="DejaVu Sans", fontsize=11, margin="0.18,0.13",
    color="#60748A", fillcolor="#F6F8FB", fontcolor="#20354B"
  ];
  edge [color="#778CA0", penwidth=1.7, arrowsize=0.7];

  sra [label="SRA acquisition + validation\nprefetch · vdb-validate · size check", fillcolor="#EEF3FA", color="#5A789E"];
  fastq [label="Paired FASTQ + raw QC\nfasterq-dump · SeqKit · FastQC · MultiQC", fillcolor="#EAF6F4", color="#3D827D"];
  fastp [label="Read preprocessing + clean QC\nfastp · SeqKit · FastQC · MultiQC", fillcolor="#EAF1FA", color="#5279AD"];
  host [label="Host alignment + pair assessment\nBowtie2 · verified alfalfa reference · BAM counts", fillcolor="#F1ECF8", color="#8065A2"];
  nonhost [label="Strict non-host extraction + validation\nremove pair if either mate maps · SeqKit · zero singletons", fillcolor="#EAF6F4", color="#3D827D"];
  kraken [label="Taxonomic classification + validation\nKraken2 · paired · MD5-verified PlusPF-8", fillcolor="#FFF3E8", color="#B57B31"];
  bracken [label="Genus abundance + validation\nBracken · matching 150-bp model", fillcolor="#FFF3E8", color="#B57B31"];

  sra -> fastq -> fastp -> host -> nonhost -> kraken -> bracken;

}
