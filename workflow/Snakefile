    output:
        f"{P['validation_root']}/{{sample}}/bracken_validation.tsv",
    params:
        python=ORCHESTRATION_PYTHON,
        validator=VALIDATOR,
    log:
        f"{P['log_root']}/{{sample}}/validate_bracken.log",
    shell:
        """
        {params.python} {params.validator} bracken \
          --abundance {input.abundance} --report {input.report} --output {output} > {log} 2>&1
        """


rule validate_ck1_manual:
    input:
        provenance="docs/raw_read_provenance.tsv",
        r1="data/interim/ck1_nonhost/SRR36739085_1.nonhost.fastq.gz",
        r2="data/interim/ck1_nonhost/SRR36739085_2.nonhost.fastq.gz",
        kraken_log="logs/raw-read-pilot/CK1_pluspf8_c0.kraken2.log",
        kraken_report="results/taxonomy/raw-read-pilot/CK1_pluspf8_c0.report",
        bracken="results/taxonomy/raw-read-pilot/CK1_pluspf8_c0_genus.bracken",
        metrics="CK1_comparison/comparison_metrics.json",
    output:
        f"{P['validation_root']}/CK-1/manual_checkpoint_validation.tsv",
    params:
        python=ORCHESTRATION_PYTHON,
        validator=VALIDATOR,
    log:
        f"{P['log_root']}/CK-1/validate_manual_checkpoint.log",
    shell:
        """
        mkdir -p $(dirname {output})
        {params.python} {params.validator} ck1 \
          --provenance {input.provenance} --r1 {input.r1} --r2 {input.r2} \
          --kraken-log {input.kraken_log} --kraken-report {input.kraken_report} \
          --bracken {input.bracken} --metrics {input.metrics} --output {output} > {log} 2>&1
        """
